{
  "name": "boxpletion",
  "displayName": "boxpletion",
  "description": "Type hinting and autocomplete hints for box::use import declaration",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:r"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "configuration": {
      "title": "boxpletion",
      "properties": {
        "boxpletion.rscriptPath": {
          "type": "string",
          "default": "Rscript",
          "description": "Path to the Rscript executable used to find installed package libraries."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src test",
    "test": "vscode-test",
    "unit": "tsc -p ./ && node --test \"out/test/*.test.js\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/baler-dev/boxpletion.git"
  }
}
